# Copy to .env for a local or Pages build. Never commit .env.
# Free CARTO basemap key: https://carto.com/basemaps/apikey/
# Restrict it to the Pages host. Localhost needs its own key if the
# dashboard will not share one with that host. Leave this unset and the
# vector styles still load. The gateway's CARTO_API_KEY is the other place
# the same key can live; a value here wins.
VITE_CARTO_API_KEY=replace-with-carto-key
