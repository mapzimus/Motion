# Copy to .dev.vars for local gateway development. Never commit .dev.vars.
AISSTREAM_API_KEY=replace-with-aisstream-key
TOMTOM_API_KEY=replace-with-tomtom-key
# Optional. Free CARTO basemap key, restricted to the Pages host.
# https://carto.com/basemaps/apikey/  Localhost needs its own key if the
# dashboard will not share one with the Pages host. Leave unset and the
# vector styles still load.
CARTO_API_KEY=replace-with-carto-key
# Optional. Swiftly expects the complete Authorization header value.
SWIFTLY_API_KEY=replace-with-swiftly-authorization-value
# Optional metro keys; each is free (docs/api-keys.md). Unset = that feed
# reports needs-key and its schedule ribbons still draw.
WMATA_API_KEY=replace-with-wmata-key
CTA_TRAIN_API_KEY=replace-with-cta-train-tracker-key
CTA_BUS_API_KEY=replace-with-cta-bus-tracker-key
METRA_ACCESS_KEY=replace-with-metra-access-key
METRA_SECRET_KEY=replace-with-metra-secret-key
BAY_511_API_KEY=replace-with-511-sf-bay-token
