{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "motion-gateway-dev",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5500,http://127.0.0.1:5500"
  },
  // One shared AISStream upstream for every viewer (worker/src/ais-hub.ts).
  // Free plan: SQLite-backed Durable Objects only. Bindings are not inherited
  // by environments, so they are repeated in staging and production below.
  "durable_objects": {
    "bindings": [{ "name": "AIS_HUB", "class_name": "AisHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AisHub"] }],
  "env": {
    "staging": {
      "name": "motion-gateway-staging",
      "durable_objects": {
        "bindings": [{ "name": "AIS_HUB", "class_name": "AisHub" }]
      },
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:5500,http://127.0.0.1:5500,https://mapzimus.github.io"
      }
    },
    "production": {
      "name": "motion-gateway",
      "durable_objects": {
        "bindings": [{ "name": "AIS_HUB", "class_name": "AisHub" }]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://mapzimus.github.io"
      }
    }
  }
}
